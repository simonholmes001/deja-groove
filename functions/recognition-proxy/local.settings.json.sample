{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "node",
    "OPENAI_KEY": "replace-with-local-openai-key",
    "OPENAI_MODEL": "gpt-5-mini",
    "SCAN_ENRICHMENT_TIMEOUT_MS": "1500",
    "ENRICHMENT_CACHE_TTL_MS": "86400000",
    "ENRICHMENT_CACHE_MAX_ENTRIES": "500",
    "DISCOGS_TOKEN": "replace-with-local-discogs-token"
  }
}
