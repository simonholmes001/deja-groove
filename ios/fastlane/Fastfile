def validated_string!(key)
  value = ENV[key]
  UI.user_error!("Missing required environment variable: #{key}") if value.nil? || value.strip.empty?
  value
end

def testflight_build_number
  value = ENV["DEJA_GROOVE_BUILD_NUMBER"] || ENV["GITHUB_RUN_NUMBER"]
  UI.user_error!("Missing build number: set DEJA_GROOVE_BUILD_NUMBER or run in GitHub Actions.") if value.nil? || value.strip.empty?
  UI.user_error!("Build number must be numeric: #{value}") unless value.match?(/\A\d+\z/)
  value
end

def xcode_container_path(key)
  value = ENV[key]
  return nil if value.nil? || value.strip.empty?

  configured_path = value.strip
  candidates = [configured_path]
  candidates << File.join("..", configured_path) unless configured_path.start_with?("/")
  resolved_path = candidates.find { |path| File.exist?(path) }

  UI.user_error!("Configured #{key} not found. Checked: #{candidates.join(', ')}") if resolved_path.nil?
  resolved_path
end

def ci_keychain_name
  ENV["MATCH_KEYCHAIN_NAME"] || "deja-groove-ci-signing.keychain"
end

def ci_keychain_password
  ENV["MATCH_KEYCHAIN_PASSWORD"]
end

def using_ci_keychain?
  !ci_keychain_password.nil? && !ci_keychain_password.strip.empty?
end

def create_ci_keychain
  return unless using_ci_keychain?

  create_keychain(
    name: ci_keychain_name,
    password: ci_keychain_password,
    default_keychain: true,
    unlock: true,
    timeout: 3600,
    lock_when_sleeps: false
  )
end

def delete_ci_keychain
  return unless using_ci_keychain?

  delete_keychain(name: ci_keychain_name)
end

def sync_appstore_signing
  options = { type: "appstore", readonly: true }
  if using_ci_keychain?
    options[:keychain_name] = ci_keychain_name
    options[:keychain_password] = ci_keychain_password
  end

  sync_code_signing(**options)
end

platform :ios do
  desc "Verify required App Store/TestFlight environment configuration"
  lane :verify_distribution_env do
    %w[
      DEJA_GROOVE_APP_IDENTIFIER
      DEJA_GROOVE_APPLE_ID
      DEJA_GROOVE_ITC_TEAM_ID
      DEJA_GROOVE_TEAM_ID
      MATCH_GIT_URL
      MATCH_PASSWORD
      MATCH_KEYCHAIN_PASSWORD
      APP_STORE_CONNECT_API_KEY_ID
      APP_STORE_CONNECT_API_ISSUER_ID
      APP_STORE_CONNECT_API_KEY_PATH
      DEJA_GROOVE_XCODE_SCHEME
    ].each { |key| validated_string!(key) }
  end

  desc "Sync App Store distribution certificates and provisioning profiles"
  lane :prepare_signing do
    verify_distribution_env
    create_ci_keychain
    sync_appstore_signing
  end

  desc "Build and upload a TestFlight build for internal testing"
  lane :upload_internal_testflight do
    verify_distribution_env
    prepare_signing
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_PATH")
    )

    build_app(
      scheme: ENV.fetch("DEJA_GROOVE_XCODE_SCHEME"),
      export_method: "app-store",
      clean: true,
      xcargs: "CURRENT_PROJECT_VERSION=#{testflight_build_number}",
      project: xcode_container_path("DEJA_GROOVE_XCODE_PROJECT"),
      workspace: xcode_container_path("DEJA_GROOVE_XCODE_WORKSPACE")
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      groups: ["Internal"]
    )
  ensure
    delete_ci_keychain
  end
end
