URL_SLASH = /
DEJA_GROOVE_RUNTIME_MODE = local_proxy
DEJA_GROOVE_API_BASE_URL = https:$(URL_SLASH)$(URL_SLASH)api.dejagroove.example
DEJA_GROOVE_RECOGNITION_PROXY_BASE_URL = https:$(URL_SLASH)$(URL_SLASH)func-deja-recognition.example
DEJA_GROOVE_RECOGNITION_PROXY_KEY = REPLACE_RECOGNITION_PROXY_KEY
DEJA_GROOVE_ENTRA_AUTHORITY = https:$(URL_SLASH)$(URL_SLASH)login.microsoftonline.com/REPLACE_TENANT_ID
DEJA_GROOVE_ENTRA_CLIENT_ID = REPLACE_ENTRA_CLIENT_ID
DEJA_GROOVE_ENTRA_REDIRECT_URI = msauth.com.dejagroove.app:$(URL_SLASH)$(URL_SLASH)auth
DEJA_GROOVE_ENTRA_SCOPES = openid profile offline_access api:$(URL_SLASH)$(URL_SLASH)REPLACE_API_APP_ID/access_as_user

#include? "Release.local.xcconfig"
