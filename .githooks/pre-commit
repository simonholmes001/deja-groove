#!/bin/sh
set -eu

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

STAGED_FILES="$(git diff --cached --name-only)"

is_staged_in_dir() {
  echo "$STAGED_FILES" | grep -E "^${1}/" >/dev/null 2>&1
}

run_dotnet_tests() {
  TARGET_DIR="$1"
  if ! is_staged_in_dir "$TARGET_DIR"; then
    echo "⏭️  No staged changes in $TARGET_DIR — skipping .NET tests."
    return 0
  fi

  if ! find "$TARGET_DIR" \( -name '*.sln' -o -name '*.csproj' \) 2>/dev/null | grep -q .; then
    echo "⏭️  No .NET project in $TARGET_DIR — skipping."
    return 0
  fi

  echo ""
  echo "🧪 Running .NET tests in $TARGET_DIR before commit..."

  DOTNET_CMD="dotnet"
  if [ -x "/usr/local/share/dotnet/dotnet" ]; then
    DOTNET_CMD="/usr/local/share/dotnet/dotnet"
  fi

  DOTNET_CLI_HOME=/tmp "$DOTNET_CMD" test "$TARGET_DIR" --verbosity minimal
  echo "✅ .NET tests passed in $TARGET_DIR."
}

run_yaml_lint() {
  if ! is_staged_in_dir ".github"; then
    return 0
  fi

  if command -v yamllint >/dev/null 2>&1; then
    echo ""
    echo "🔍 Linting changed YAML files in .github/..."
    echo "$STAGED_FILES" | grep -E "^\.github/.*\.ya?ml$" | while read -r f; do
      yamllint "$f" && echo "✅  $f"
    done
  fi
}

run_dotnet_tests "backend"
run_yaml_lint

echo ""
echo "✅ Pre-commit guardrails passed."
