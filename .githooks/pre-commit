#!/bin/sh
set -eu

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

run_node_tests() {
  DIR="$1"
  if [ -f "$DIR/package.json" ]; then
    echo ""
    echo "Running Node tests in $DIR before commit (always)..."
    if [ -f "$DIR/package-lock.json" ]; then
      npm --prefix "$DIR" ci --workspaces=false >/dev/null 2>&1 || npm --prefix "$DIR" ci --workspaces=false
    else
      npm --prefix "$DIR" install >/dev/null 2>&1 || npm --prefix "$DIR" install
    fi

    if npm --prefix "$DIR" run | grep -q " test"; then
      npm --prefix "$DIR" run test
    else
      echo "No test script in $DIR/package.json; skipping."
      return 0
    fi

    echo "Node tests passed in $DIR."
  else
    echo "No Node project in $DIR; skipping."
  fi
}

run_swift_tests() {
  TARGET_DIR="$1"
  # Fail closed: Swift must be installed to commit in this repo because iOS
  # unit tests are mandatory on every commit.
  if ! command -v swift >/dev/null 2>&1; then
    echo "swift not found in PATH. Cannot run mandatory iOS tests in $TARGET_DIR."
    echo "    Install Xcode (https://developer.apple.com/xcode/) then re-run ./scripts/setup-hooks.sh"
    return 1
  fi

  if [ -f "$TARGET_DIR/Package.swift" ]; then
    echo ""
    echo "Running Swift tests in $TARGET_DIR before commit (always)..."
    swift test --package-path "$TARGET_DIR"
    echo "Swift tests passed in $TARGET_DIR."
  else
    echo "No Swift package in $TARGET_DIR; skipping."
  fi
}

run_backend_build_if_needed() {
  if ! git diff --cached --name-only | grep -Eq '^(backend/|\.github/workflows/ci\.yaml|\.githooks/pre-commit)$'; then
    echo "No backend or backend guardrail changes staged; skipping .NET build."
    return 0
  fi

  if ! command -v dotnet >/dev/null 2>&1; then
    echo "dotnet not found in PATH. Cannot build backend solution."
    echo "    Install the .NET SDK, then re-run ./scripts/setup-hooks.sh"
    return 1
  fi

  echo ""
  echo "Building backend solution before commit..."
  dotnet restore backend/DejaGroove.sln --verbosity minimal
  dotnet build backend/DejaGroove.sln --configuration Release --no-restore --verbosity minimal
  echo "Backend solution build passed."
}

# Run local commit guardrails
run_node_tests "cli"
run_node_tests "frontend"
run_swift_tests "ios/DejaGrooveAuth"
run_swift_tests "ios/DejaGrooveApp"
run_backend_build_if_needed

echo ""
echo "Pre-commit guardrails passed."
